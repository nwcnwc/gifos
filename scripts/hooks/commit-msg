#!/usr/bin/env node
/*
 * commit-msg — the last cheap moment to catch a machine name.
 *
 * THIS REPO IS PUBLIC, AND GITHUB RENDERS COMMIT MESSAGES. A hostname in a
 * message is the same exposure as one in a tracked file, with one difference
 * that decides where this file lives: a file can be fixed with an edit, a
 * pushed message can only be fixed by rewriting history and force-pushing over
 * everyone. So the gate (test/unit/no-topology.js) is too late by design — it
 * can only tell you what it is now too expensive to fix. This runs while the
 * message is still a draft, where the fix is deleting a word.
 *
 * IT CHECKS THE SAME FIVE THINGS THE GATE DOES, and that is the whole point —
 * it shipped checking one of them, and a peer caught it: names, plus the four
 * SHAPES from test/lib/topology-shapes.js (tailnet address, magic-dns name,
 * telegram bot token, adb device serial). The shapes matter MORE here, not
 * less: a bot token is a live credential, and "adb -s <serial> on the
 * <gpu-box>" is written by somebody doing exactly what the rule asked and still
 * lands a serial on the public web.
 *
 * Names use the same trick as the guard: it never learns them, it reads them
 * from the LOCAL, never-committed ~/.gifos-behavior-hosts.json. The four shapes
 * are patterns and need no hosts file — so on a box without one this hook now
 * still checks four of five things, where it used to exit immediately and check
 * nothing.
 *
 * HOW TO CHECK IT ACTUALLY FIRES — and there is a trap here that produced a
 * confident false alarm the first time somebody tried (2026-08-25). The obvious
 * probe is to take `hosts[0].name` out of the hosts file and put it in a draft.
 * That PASSES, and the naive reading is "the hook is dead". It is not: entry 0
 * is the generic local entry (name "local"), which the scan deletes on purpose
 * two blocks below, exactly so that "run it here" is not treated as a machine.
 * PROBE WITH AN ENTRY THAT HAS AN `ssh` KEY — those are the real remote boxes.
 *
 *   node scripts/hooks/commit-msg <(printf 'test\n\nmeasured on <a-name-with-ssh>\n')
 *   # exit 1 and a "line N: …xx…" diagnostic = working. exit 0 = look again.
 *
 * (Process substitution means there is no probe file to clean up. If you write
 * the draft to a real file instead, shred it — it holds a real hostname.)
 *
 * INSTALL (per clone, once):
 *   git config core.hooksPath scripts/hooks
 * REMOVE:
 *   git config --unset core.hooksPath
 * BYPASS, if you genuinely must: git commit --no-verify
 */
'use strict';
const fs = require('fs');
const os = require('os');
const path = require('path');

const file = process.argv[2];
if (!file) process.exit(0);

const HOSTS = process.env.GIFOS_FLEET || process.env.BEHAVIOR_HOSTS
  || path.join(os.homedir(), '.gifos-behavior-hosts.json');

let fleet = null;
try { fleet = JSON.parse(fs.readFileSync(HOSTS, 'utf8')); } catch (e) {}

const names = new Set();
for (const h of ((fleet && fleet.hosts) || [])) {
  for (const k of ['name', 'ssh']) if (h && h[k]) names.add(String(h[k]));
}
// The hosts file's own words for "no ssh, run it here" — not machine names.
// THIS IS THE LINE THAT MAKES THE OBVIOUS PROBE LIE (see the header): entry 0
// is usually the local one, so probing with hosts[0].name passes correctly and
// reads like a dead hook.
for (const generic of ['local', 'localhost']) names.delete(generic);
const hostish = [...names].filter((n) => n.length >= 4);

// A NAME, NOT A SUBSTRING — the same rule test/unit/no-topology.js applies, and
// the two must not drift: a name the gate allows and this hook refuses would
// block commits over text that merely contains one inside a longer word. A
// match may not be FLANKED by [A-Za-z0-9]; hyphen, dot, slash, @ and whitespace
// are not in that class, so `<name>-2`, `<name>.local` and `user@<name>` still
// match.
const esc = (n) => n.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const needle = (n) => new RegExp('(?<![A-Za-z0-9])' + esc(n) + '(?![A-Za-z0-9])', 'i');

// The four patterns, shared with test/unit/no-topology.js so the two can never
// disagree. A broken require must not block every commit in the repo, but it
// must not be silent either — the one thing worse than a noisy guard is one
// that quietly stopped guarding.
let shapes = null;
try { shapes = require(path.join(__dirname, '..', '..', 'test', 'lib', 'topology-shapes.js')); }
catch (e) { process.stderr.write('commit-msg: WARNING — topology-shapes.js did not load; shape checks skipped.\n'); }

if (!hostish.length && !shapes) process.exit(0);   // nothing to check with

let msg = '';
try { msg = fs.readFileSync(file, 'utf8'); } catch (e) { process.exit(0); }

// Comment lines are stripped by git before the message is stored, so a name in
// the `# Changes to be committed:` block is not a leak and must not block.
const lines = msg.split('\n').filter((l) => !/^\s*#/.test(l));
const hits = [];
lines.forEach((line, i) => {
  for (const n of hostish) {
    if (needle(n).test(line)) {
      // WHERE, never WHAT — the same rule the guard follows, so that this
      // output is safe to paste into an issue or a transcript.
      hits.push('  line ' + (i + 1) + ': a machine name (…' + n.slice(0, 2) + '…)');
      break;
    }
  }
});
// A shape names ITSELF safely — "a telegram bot token" gives away nothing, and
// the author needs to know which of the four it is to fix it.
if (shapes) {
  for (const h of shapes.scanLines(lines)) hits.push('  line ' + h.line + ': ' + h.what);
}
if (!hits.length) process.exit(0);

process.stderr.write([
  '',
  'COMMIT REFUSED — this message carries a private identifier, and this repo is PUBLIC.',
  'GitHub renders every commit message on the open web, and a pushed message can',
  'only be fixed by rewriting history. Right now it costs one word.',
  '',
  hits.join('\n'),
  '',
  'Write the ROLE instead:',
  '  <behavior-box>  <gate-host>  <orchestrator>  <gpu-box>  <llm-box>',
  '  <monitor-pi>  <resident-model>  <orchestrator-tailnet-addr>',
  '',
  '"red every run on the <gpu-box> and green on every slower box" says all of it.',
  'Core counts, architectures, chromium revisions and measurements are hardware',
  'FACTS, not identities — keep those.',
  '',
  'Your message is kept at .git/COMMIT_EDITMSG. See CLAUDE.md and',
  'test/unit/no-topology.js.',
  '',
].join('\n'));
process.exit(1);
