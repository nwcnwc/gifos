  "measurements": [
    { "id": "corrected-reflectance", "title": "Corrected Reflectance", "blurb": "What the satellite saw, as close to a photograph as an instrument gets — every day since 2000." },
    { "id": "earth-at-night", "title": "Earth at Night", "blurb": "City light, gas flares, fishing fleets and the moonlit clouds between them." },
    { "id": "geostationary", "title": "Geostationary", "blurb": "One hemisphere, every ten minutes. This is what a hurricane looks like while it turns." },
    { "id": "fires", "title": "Fires & Thermal Anomalies", "blurb": "Pixels hot enough to be burning, detected twice a day per satellite." },
    { "id": "surface-reflectance", "title": "Land Surface Reflectance", "blurb": "Atmosphere removed — the ground's own colour, and false-colour bands that pull vegetation, burn scars and cities apart." },
    { "id": "blue-marble", "title": "Blue Marble", "blurb": "The cloudless Earth. No date, no gaps — the reference picture." },
    { "id": "reference", "title": "Reference", "blurb": "Coastlines, borders and labels to hang the imagery on." },
    { "id": "aerosol", "title": "Aerosol Optical Depth", "blurb": "How much smoke, dust and haze the air column is carrying." },
    { "id": "dust", "title": "Dust", "blurb": "Saharan and Gobi dust, scored from infrared." },
    { "id": "surface-water", "title": "Surface Water Extent", "blurb": "Where there is water today that usually isn't — flooding, at 30 m." },
    { "id": "vegetation-disturbance", "title": "Vegetation Disturbance", "blurb": "Land that has lost its cover since last year: fire, logging, drought, development." },
    { "id": "water-vapor", "title": "Water Vapour", "blurb": "The invisible ocean overhead." },
    { "id": "clouds", "title": "Clouds", "blurb": "Cloud fraction and cloud-top temperature — how much sky is covered and how high the tops are." },
    { "id": "precipitation", "title": "Precipitation", "blurb": "Rain and snow rate, merged from a constellation." },
    { "id": "air-quality", "title": "Air Quality", "blurb": "Nitrogen dioxide, carbon monoxide and total column ozone." },
    { "id": "land-temp", "title": "Land Surface Temperature", "blurb": "The skin temperature of the ground itself — day and night." },
    { "id": "vegetation", "title": "Vegetation Indices", "blurb": "How green the land is, and how that changes with the seasons." },
    { "id": "snow", "title": "Snow Cover", "blurb": "Snow on the ground, and how much water is in it." },
    { "id": "land-cover", "title": "Land Cover", "blurb": "Forest, cropland, urban, ice — classified once a year." },
    { "id": "population", "title": "Population Density", "blurb": "Where people are, on the same grid as the imagery." },
    { "id": "sst", "title": "Sea Surface Temperature", "blurb": "Ocean skin temperature, and how far it is from normal." },
    { "id": "chlorophyll", "title": "Chlorophyll a", "blurb": "Where the ocean is alive — phytoplankton, blooms and currents." },
    { "id": "sea-ice", "title": "Sea Ice", "blurb": "Ice concentration at both poles, daily since 2012." },
    { "id": "orbits", "title": "Orbital Tracks", "blurb": "Where the satellite actually flew, with the time it passed." }
  ],

