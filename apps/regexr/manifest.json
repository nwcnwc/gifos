{
  "gifos": "1.0",
  "appId": "regexr",
  "name": "RegExr",
  "shortName": "RegExr",
  "version": "1.0.0",
  "minBuild": 947,
  "description": "Live regex tester with a cheatsheet. The pattern lives in this file.",
  "entry": "index.html",
  "accent": [112, 176, 224],
  "help": "help.md",
  "capabilities": {
    "db": true,
    "multiplayer": true
  },
  "data": {
    "save": { "visibility": "private" },
    "recents": { "visibility": "private" },
    "room": { "visibility": "read-write" }
