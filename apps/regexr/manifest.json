    "pattern": {
      "label": "Open this regular expression",
      "detail": "The pattern to test."
    },
    "text": {
      "label": "Test it against this text",
      "detail": "Sample text to match."
    },
    "flags": {
      "label": "Expression flags",
      "detail": "Like g, i, or m."
    }
  }
