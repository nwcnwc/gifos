{
  "gifos": "1.0",
  "appId": "anyroad",
  "name": "Anyroad",
  "shortName": "Anyroad",
  "version": "1.0.0",
  "minBuild": 1089,
  "entry": "index.html",
  "accent": [
    92,
    178,
    255
  ],
  "capabilities": {
    "db": true,
    "multiplayer": true,
    "network": [
      "s3.amazonaws.com",
      "overpass-api.de",
      "overpass.kumi.systems",
      "overpass.private.coffee",
      "overpass.osm.ch",
      "nominatim.openstreetmap.org"
    ],
    "pool": [
      "overpass-api.de",
      "overpass.kumi.systems",
      "overpass.private.coffee",
      "overpass.osm.ch"
    ],
    "api": [
      "maptiler"
    ],
    "motion": true
  },
  "launch": {
    "at": {
      "label": "Open at a place the link picked",
      "detail": "Anyroad normally starts by asking you where to go; this link answers for you. A place name or a lat,lon."
    },
    "fly": {
      "label": "Arrive in the aeroplane, already in the air",
      "detail": "You take off on landing instead of starting on the road."
    },
    "label": {
      "label": "Call that place something",
      "detail": "Only the name shown on the HUD — it does not change where you go."
    }
  },
  "data": {
    "prefs": {
      "visibility": "private"
    },
    "roadcache": {
      "visibility": "private"
    },
    "players": {
      "visibility": "read-write"
    },
    "race": {
      "visibility": "read-write"
    }
  }
}
